{
  // DLT645PCD 串口模拟器配置示例
  "instances": [
    {
      "name": "模拟从站-01",
      // 表地址（12 位十六进制字符串）
      "meter_addr": "202601200001",
      // PCD 设备号（2 位十六进制字符串）
      "device_no": "01",
      // 对外暴露的伪串口软链接路径
      "pty_link": "/tmp/ttyDLT645_PCD_01",
      // 读请求 DI 到固定回包数据的映射
      "read_map": [
        {
          "di": "02030000",
          "data_hex": "11223344"
        },
        {
          "di": "06010801",
          "data_hex": "55667788"
        }
      ]
    },
    {
      "name": "模拟从站-02",
      "meter_addr": "202601200001",
      "device_no": "02",
      "pty_link": "/tmp/ttyDLT645_PCD_02",
      "read_map": [
        {
          "di": "02030000",
          "data_hex": "99AABBCC"
        }
      ]
    }
  ]
}
