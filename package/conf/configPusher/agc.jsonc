{
  "agc": {
    "groups": [
      {
        "upsert": {
          "create_only": false,
          "config": {
            "group_name": "1号AGC控制组",
            // 104 下发的总有功给定。
            "p_cmd": {
              "signal": {
                "tag": "AGC总有功给定输入",
                "unit": "kW",
                "scale": 1.0,
                "offset": 0.0
              },
              "mode": "VALUE_MODE_ABSOLUTE",
              "delta_base": "DELTA_BASE_UNSPECIFIED"
            },
            // AGC 会在相关输入点变化时直接按总有功目标做成员分配，不再配置步长限制/逐步逼近参数。
            "strategy": {
              "weighted": {}
            },
            "members": [
              {
                "member_name": "RS485-6-1号逆变器",
                "controllable": true,
                "capacity_kw": 50.0,
                "weight": 50.0,
                "min_kw": 0.0,
                "max_kw": 50.0,
                "p_meas": {
                  "tag": "RS485-6-1号逆变器有功功率量测",
                  "unit": "kW",
                  "scale": 1.0,
                  "offset": 0.0
                },
                "p_set": {
                  "signal": {
                    "tag": "RS485-6-1号逆变器有功功率设定",
                    "unit": "kW",
                    "scale": 1.0,
                    "offset": 0.0
                  },
                  "mode": "VALUE_MODE_ABSOLUTE",
                  "delta_base": "DELTA_BASE_UNSPECIFIED"
                }
              },
              {
                "member_name": "RS485-6-2号逆变器",
                "controllable": true,
                "capacity_kw": 50.0,
                "weight": 50.0,
                "min_kw": 0.0,
                "max_kw": 50.0,
                "p_meas": {
                  "tag": "RS485-6-2号逆变器有功功率量测",
                  "unit": "kW",
                  "scale": 1.0,
                  "offset": 0.0
                },
                "p_set": {
                  "signal": {
                    "tag": "RS485-6-2号逆变器有功功率设定",
                    "unit": "kW",
                    "scale": 1.0,
                    "offset": 0.0
                  },
                  "mode": "VALUE_MODE_ABSOLUTE",
                  "delta_base": "DELTA_BASE_UNSPECIFIED"
                }
              },
              {
                "member_name": "RS485-5-1号逆变器",
                "controllable": true,
                "capacity_kw": 100.0,
                "weight": 100.0,
                "min_kw": 0.0,
                "max_kw": 100.0,
                "p_meas": {
                  "tag": "RS485-5-1号逆变器有功功率量测",
                  "unit": "kW",
                  "scale": 1.0,
                  "offset": 0.0
                },
                "p_set": {
                  "signal": {
                    "tag": "RS485-5-1号逆变器有功功率设定",
                    "unit": "kW",
                    "scale": 1.0,
                    "offset": 0.0
                  },
                  "mode": "VALUE_MODE_ABSOLUTE",
                  "delta_base": "DELTA_BASE_UNSPECIFIED"
                }
              },
              {
                "member_name": "RS485-5-2号逆变器",
                "controllable": true,
                "capacity_kw": 100.0,
                "weight": 100.0,
                "min_kw": 0.0,
                "max_kw": 100.0,
                "p_meas": {
                  "tag": "RS485-5-2号逆变器有功功率量测",
                  "unit": "kW",
                  "scale": 1.0,
                  "offset": 0.0
                },
                "p_set": {
                  "signal": {
                    "tag": "RS485-5-2号逆变器有功功率设定",
                    "unit": "kW",
                    "scale": 1.0,
                    "offset": 0.0
                  },
                  "mode": "VALUE_MODE_ABSOLUTE",
                  "delta_base": "DELTA_BASE_UNSPECIFIED"
                }
              }
            ],
            "outputs": {
              "p_total_meas": {
                "tag": "AGC总有功实时值",
                "unit": "kW",
                "scale": 1.0,
                "offset": 0.0
              },
              "p_total_target": {
                "tag": "AGC总有功目标值",
                "unit": "kW",
                "scale": 1.0,
                "offset": 0.0
              },
              "p_total_error": {
                "tag": "AGC总有功偏差",
                "unit": "kW",
                "scale": 1.0,
                "offset": 0.0
              }
            }
          }
        },
        // true 仅用于兼容旧模板与日志说明；当前版本不额外调用 StartGroup。
        // AGC 会在配置达到当前最小可运行条件后自动判定是否启动控制组功能。
        "start": true
      }
    ]
  }
}
