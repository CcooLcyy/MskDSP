{
  "agc": {
    "groups": [
      {
        "upsert": {
          "create_only": false,
          "config": {
            "group_name": "1号AGC控制组",
            // 104 下发的总有功给定。
            "p_cmd": {
              "signal": {
                "tag": "AGC总有功给定输入",
                "unit": "kW",
                "scale": 1.0,
                "offset": 0.0
              },
              "mode": "VALUE_MODE_ABSOLUTE",
              "delta_base": "DELTA_BASE_UNSPECIFIED"
            },
            // 当前按 1s 周期做简单闭环；如现场希望动作更快，可适当减小 period_ms。
            "loop": {
              "period_ms": 1000,
              "deadband_kw": 2.0,
              "max_step_kw": 20.0,
              "kp": 1.0
            },
            "strategy": {
              "weighted": {}
            },
            "members": [
              {
                "member_name": "RS485-6-1号逆变器",
                "controllable": true,
                "capacity_kw": 50.0,
                "weight": 50.0,
                "min_kw": 0.0,
                "max_kw": 50.0,
                "p_meas": {
                  "tag": "RS485-6-1号逆变器有功功率量测",
                  "unit": "kW",
                  "scale": 1.0,
                  "offset": 0.0
                },
                "p_set": {
                  "signal": {
                    "tag": "RS485-6-1号逆变器有功功率设定",
                    "unit": "kW",
                    "scale": 1.0,
                    "offset": 0.0
                  },
                  "mode": "VALUE_MODE_ABSOLUTE",
                  "delta_base": "DELTA_BASE_UNSPECIFIED"
                }
              },
              {
                "member_name": "RS485-6-2号逆变器",
                "controllable": true,
                "capacity_kw": 50.0,
                "weight": 50.0,
                "min_kw": 0.0,
                "max_kw": 50.0,
                "p_meas": {
                  "tag": "RS485-6-2号逆变器有功功率量测",
                  "unit": "kW",
                  "scale": 1.0,
                  "offset": 0.0
                },
                "p_set": {
                  "signal": {
                    "tag": "RS485-6-2号逆变器有功功率设定",
                    "unit": "kW",
                    "scale": 1.0,
                    "offset": 0.0
                  },
                  "mode": "VALUE_MODE_ABSOLUTE",
                  "delta_base": "DELTA_BASE_UNSPECIFIED"
                }
              },
              {
                "member_name": "RS485-5-1号逆变器",
                "controllable": true,
                "capacity_kw": 100.0,
                "weight": 100.0,
                "min_kw": 0.0,
                "max_kw": 100.0,
                "p_meas": {
                  "tag": "RS485-5-1号逆变器有功功率量测",
                  "unit": "kW",
                  "scale": 1.0,
                  "offset": 0.0
                },
                "p_set": {
                  "signal": {
                    "tag": "RS485-5-1号逆变器有功功率设定",
                    "unit": "kW",
                    "scale": 1.0,
                    "offset": 0.0
                  },
                  "mode": "VALUE_MODE_ABSOLUTE",
                  "delta_base": "DELTA_BASE_UNSPECIFIED"
                }
              },
              {
                "member_name": "RS485-5-2号逆变器",
                "controllable": true,
                "capacity_kw": 100.0,
                "weight": 100.0,
                "min_kw": 0.0,
                "max_kw": 100.0,
                "p_meas": {
                  "tag": "RS485-5-2号逆变器有功功率量测",
                  "unit": "kW",
                  "scale": 1.0,
                  "offset": 0.0
                },
                "p_set": {
                  "signal": {
                    "tag": "RS485-5-2号逆变器有功功率设定",
                    "unit": "kW",
                    "scale": 1.0,
                    "offset": 0.0
                  },
                  "mode": "VALUE_MODE_ABSOLUTE",
                  "delta_base": "DELTA_BASE_UNSPECIFIED"
                }
              }
            ],
            "outputs": {
              "p_total_meas": {
                "tag": "AGC总有功实时值",
                "unit": "kW",
                "scale": 1.0,
                "offset": 0.0
              },
              "p_total_target": {
                "tag": "AGC总有功目标值",
                "unit": "kW",
                "scale": 1.0,
                "offset": 0.0
              },
              "p_total_error": {
                "tag": "AGC总有功偏差",
                "unit": "kW",
                "scale": 1.0,
                "offset": 0.0
              }
            }
          }
        },
        // true 表示下发后启动控制组内控制环功能。
        "start": true
      }
    ]
  }
}
