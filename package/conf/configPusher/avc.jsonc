{
  "avc": {
    "groups": [
      {
        "upsert": {
          "create_only": false,
          "config": {
            "group_name": "1号AVC控制组",
            // 主电压量测点：用于观测当前母线电压。
            "voltage_meas": {
              "tag": "1号母线电压量测",
              "unit": "kV",
              "scale": 1.0,
              "offset": 0.0
            },
            // 目标电压模式：上位机下目标电压，AVC 按 kp/deadband 换算总无功目标。
            "voltage_cmd": {
              "tag": "1号AVC目标电压输入",
              "unit": "kV",
              "scale": 1.0,
              "offset": 0.0
            },
            "voltage_control": {
              "kp": 1000.0,
              "deadband": 0.02
            },
            "strategy": {
              "weighted": {}
            },
            "members": [
              {
                "member_name": "RS485-6-1号逆变器",
                "controllable": true,
                "weight": 50.0,
                "q_min_kvar": -50.0,
                "q_max_kvar": 50.0,
                "q_meas": {
                  "tag": "RS485-6-1号逆变器无功量测",
                  "unit": "kVar",
                  "scale": 1.0,
                  "offset": 0.0
                },
                "q_set": {
                  "signal": {
                    "tag": "RS485-6-1号逆变器无功设定",
                    "unit": "kVar",
                    "scale": 1.0,
                    "offset": 0.0
                  },
                  "mode": "VALUE_MODE_ABSOLUTE",
                  "delta_base": "DELTA_BASE_UNSPECIFIED"
                }
              },
              {
                "member_name": "RS485-6-2号逆变器",
                "controllable": true,
                "weight": 50.0,
                "q_min_kvar": -50.0,
                "q_max_kvar": 50.0,
                "q_meas": {
                  "tag": "RS485-6-2号逆变器无功量测",
                  "unit": "kVar",
                  "scale": 1.0,
                  "offset": 0.0
                },
                "q_set": {
                  "signal": {
                    "tag": "RS485-6-2号逆变器无功设定",
                    "unit": "kVar",
                    "scale": 1.0,
                    "offset": 0.0
                  },
                  "mode": "VALUE_MODE_ABSOLUTE",
                  "delta_base": "DELTA_BASE_UNSPECIFIED"
                }
              }
            ]
          }
        },
        // true 仅用于兼容旧模板与日志说明；当前版本不额外调用 StartGroup。
        "start": true
      }
    ]
  }
}
