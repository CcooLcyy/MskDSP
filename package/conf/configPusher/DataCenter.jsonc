{
  // DataCenter 配置下发示例（仅对已存在连接生效）
  "point_tables": [
    {
      "module_name": "IEC104",
      "conn_name": "模拟IEC104从站",
      "replace": true,
      "tags": [
        // 遥测
        "a",
        "DLT645-B相电压",
        "DLT645-C相电压",
        "AGC-1号逆变器当前功率",
        "AGC-2号逆变器当前功率",
        "AGC-当前逆变器总功率",
        "AGC-总逆变器功率目标值",
        "AGC-总逆变器功率距离目标值偏差",
        "Modbus-本地主站-A相电压",
        "Modbus-本地主站-A相电流",
        // 遥调
        "AGC遥调控制点",
        "DLT645-有功功率设定值"
      ]
    },
    {
      "module_name": "DLT645",
      "conn_name": "模拟DLT645_LORA主站_01",
      "replace": true,
      "tags": [
        "A相电压",
        "B相电压",
        "C相电压",
        "有功功率设定值",
        "有功功率实际值"
      ]
    },
    {
      "module_name": "DLT645",
      "conn_name": "模拟DLT645_LORA主站_02",
      "replace": true,
      "tags": [
        "A相电压",
        "B相电压",
        "C相电压",
        "有功功率设定值",
        "有功功率实际值"
      ]
    },
    {
      "module_name": "AGC",
      "conn_name": "1号AGC控制组",
      "replace": true,
      "tags": [
        "P_CMD",
        "INV1_P_MEAS",
        "INV1_P_SET",
        "INV2_P_MEAS",
        "INV2_P_SET",
        "P_TOTAL_MEAS",
        "P_TOTAL_TARGET",
        "P_TOTAL_ERROR"
      ]
    },
    {
      "module_name": "ModbusRTU",
      "conn_name": "本地Modbus主站",
      "replace": true,
      "tags": [
        "本地主站-A相电压",
        "本地主站-A相电流"
      ]
    }
  ],
  "routes": {
    "replace": true,
    "routes": [
      // 本地Modbus主站出口路由
      {
        "src": {
          "module_name": "ModbusRTU",
          "conn_name": "本地Modbus主站",
          "tag": "本地主站-A相电压"
        },
        "dst": {
          "module_name": "IEC104",
          "conn_name": "模拟IEC104从站",
          "tag": "Modbus-本地主站-A相电压"
        }
      },
      {
        "src": {
          "module_name": "ModbusRTU",
          "conn_name": "本地Modbus主站",
          "tag": "本地主站-A相电流"
        },
        "dst": {
          "module_name": "IEC104",
          "conn_name": "模拟IEC104从站",
          "tag": "Modbus-本地主站-A相电流"
        }
      },
      // AGC路由
      {
        "src": {
          "module_name": "IEC104",
          "conn_name": "模拟IEC104从站",
          "tag": "AGC遥调控制点"
        },
        "dst": {
          "module_name": "AGC",
          "conn_name": "1号AGC控制组",
          "tag": "P_CMD"
        }
      },
      {
        "src": {
          "module_name": "AGC",
          "conn_name": "1号AGC控制组",
          "tag": "INV1_P_MEAS"
        },
        "dst": {
          "module_name": "IEC104",
          "conn_name": "模拟IEC104从站",
          "tag": "AGC-1号逆变器当前功率"
        }
      },
      {
        "src": {
          "module_name": "AGC",
          "conn_name": "1号AGC控制组",
          "tag": "INV2_P_MEAS"
        },
        "dst": {
          "module_name": "IEC104",
          "conn_name": "模拟IEC104从站",
          "tag": "AGC-2号逆变器当前功率"
        }
      },
      {
        "src": {
          "module_name": "AGC",
          "conn_name": "1号AGC控制组",
          "tag": "P_TOTAL_MEAS"
        },
        "dst": {
          "module_name": "IEC104",
          "conn_name": "模拟IEC104从站",
          "tag": "AGC-当前逆变器总功率"
        }
      },
      {
        "src": {
          "module_name": "AGC",
          "conn_name": "1号AGC控制组",
          "tag": "P_TOTAL_TARGET"
        },
        "dst": {
          "module_name": "IEC104",
          "conn_name": "模拟IEC104从站",
          "tag": "AGC-总逆变器功率目标值"
        }
      },
      {
        "src": {
          "module_name": "AGC",
          "conn_name": "1号AGC控制组",
          "tag": "P_TOTAL_ERROR"
        },
        "dst": {
          "module_name": "IEC104",
          "conn_name": "模拟IEC104从站",
          "tag": "AGC-总逆变器功率距离目标值偏差"
        }
      },
      {
        "src": {
          "module_name": "DLT645",
          "conn_name": "模拟DLT645_LORA主站_01",
          "tag": "有功功率实际值"
        },
        "dst": {
          "module_name": "AGC",
          "conn_name": "1号AGC控制组",
          "tag": "INV1_P_MEAS"
        }
      },
      {
        "src": {
          "module_name": "DLT645",
          "conn_name": "模拟DLT645_LORA主站_02",
          "tag": "有功功率实际值"
        },
        "dst": {
          "module_name": "AGC",
          "conn_name": "1号AGC控制组",
          "tag": "INV2_P_MEAS"
        }
      },
      {
        "src": {
          "module_name": "AGC",
          "conn_name": "1号AGC控制组",
          "tag": "INV1_P_SET"
        },
        "dst": {
          "module_name": "DLT645",
          "conn_name": "模拟DLT645_LORA主站_01",
          "tag": "有功功率设定值"
        }
      },
      {
        "src": {
          "module_name": "AGC",
          "conn_name": "1号AGC控制组",
          "tag": "INV2_P_SET"
        },
        "dst": {
          "module_name": "DLT645",
          "conn_name": "模拟DLT645_LORA主站_02",
          "tag": "有功功率设定值"
        }
      }
    ]
  }
}