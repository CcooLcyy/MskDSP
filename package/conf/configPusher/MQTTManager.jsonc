{
  // MQTTManager 配置下发示例（仅供 configPusher 下发/示例使用）
  // 脚本文件路径相对可执行程序同目录的 conf/MQTTManager/script
  "profiles": [
    {
      "profile_id": "main",
      "connection": {
        "broker_uri": "tcp://127.0.0.1:1883",
        "client_id": "mqtt_manager_main",
        "username": "user",
        "password": "pass",
        "keepalive_sec": 30,
        "clean_session": true
      },
      "script": {
        // inline_script 优先于 file_path
        "inline_script": "function decode(topic, payload, props)\n  return { data = { topic = topic, payload = payload }, meta = {} }\nend\n\nfunction encode(topic, data, props)\n  return data[\"payload\"] or \"\"\nend\n",
        "file_path": "main.lua",
        "decode_entry": "decode",
        "encode_entry": "encode"
      }
    },
    {
      "profile_id": "backup",
      "connection": {
        "broker_uri": "tcp://127.0.0.1:1883",
        "client_id": "mqtt_manager_backup",
        "keepalive_sec": 30,
        "clean_session": true
      },
      "script": {
        "file_path": "backup.lua",
        "decode_entry": "decode",
        "encode_entry": "encode"
      }
    }
  ]
}
