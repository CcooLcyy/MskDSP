{
  // COMMock 配置下发示例（仅在 COMMock 模块已启动时生效）
  "com_mock": {
    "ports": [
      {
        "name": "com-1",
        "dev_path": "/dev/COMMock0",
        "peer_name": "com-2"
      },
      {
        "name": "com-2",
        "dev_path": "/dev/COMMock1",
        "peer_name": "com-1"
      }
    ]
  }
}
