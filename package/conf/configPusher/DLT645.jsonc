{
  // DLT645 配置下发示例（仅供 configPusher 下发/示例使用）
  "dlt645": {
    "mqtt": {
      "host": "127.0.0.1",
      "port": 1884,
      "client_id": "dlt645",
      "username": "",
      "password": "",
      "keepalive_sec": 30,
      "clean_session": true,
      "connect_timeout_ms": 3000
    },
    "links": [
      {
        "link": {
          "config": {
            "conn_name": "表计-01",
            "protocol_variant": "DLT645PCD",
            "meter_addr": "202601200001",
            "device_no": "01",
            "transport_type": "TRANSPORT_MQTT_UART",
            "comm_mode": "COMM_MODE_LORA",
            "poll_interval_ms": 1000,
            "request_timeout_ms": 300000
          }
        },
        "point_table": {
          "replace": true,
          "points": [
            {
              "tag": "A相电压",
              "di": "02010100",
              "data_len": 3,
              "type": "DATA_TYPE_BCD",
              "access": "ACCESS_READ_ONLY",
              "scale": 0.01,
              "offset": 0.0,
              "deadband": 0.0
            }
          ]
        },
        // start 表示启动该设备的通信任务
        "start": true
      }
    ]
  }
}