{
  // DLT645 配置下发示例（仅供 configPusher 下发/示例使用）
  "dlt645": {
    "mqtt": {
      "host": "127.0.0.1",
      "port": 1883,
      "client_id": "dlt645",
      "username": "",
      "password": "",
      "keepalive_sec": 30,
      "clean_session": true,
      "connect_timeout_ms": 3000
    },
    "links": [
      {
        "link": {
          "config": {
            // conn_name 可使用 {device_no} 占位符，按 device_nos 展开后自动替换
            "conn_name": "模拟DLT645_LORA主站_{device_no}",
            "protocol_variant": "DLT645PCD",
            "meter_addr": "123456789011",
            "transport_type": "TRANSPORT_MQTT_UART",
            "comm_mode": "COMM_MODE_LORA",
            // 注意：以下串口参数在 Lora 模式下不会生效，仅用于预置/示例。
            "serial_port": "RS485-1",
            "serial_baud_rate": 9600,
            "serial_data_bits": 8,
            "serial_parity": "SERIAL_PARITY_NONE",
            "serial_stop_bits": "SERIAL_STOP_BITS_ONE",
            "serial_byte_timeout_ms": 100,
            "serial_frame_timeout_ms": 100,
            "serial_est_size": 256,
            "poll_interval_ms": 1000,
            "request_timeout_ms": 300000
          }
        },
        // 批量设备序号：展开为多条链路，除 device_no 与 conn_name 外其余配置保持一致
        "device_nos": [
          "01"
        ],
        "point_table": {
          "replace": true,
          "points": [
            {
              "tag": "有功功率设定值",
              "di": "06010801",
              "data_len": 4,
              "type": "DATA_TYPE_BCD",
              "access": "ACCESS_WRITE_ONLY",
              "scale": 0.001,
              "offset": 0.0,
              "deadband": 0.0
            },
            {
              "tag": "有功功率实际值",
              "di": "02030000",
              "data_len": 4,
              "type": "DATA_TYPE_BCD",
              "access": "ACCESS_READ_ONLY",
              "scale": 0.001,
              "offset": 0.0,
              "deadband": 0.0
            }
          ],
          "blocks": [
            {
              // 电压数据块：DI=0201FF00，总长度 9（A/B/C 三相各 3 字节 BCD）
              "block_di": "0201FF00",
              "block_data_len": 9,
              "items": [
                {
                  "tag": "A相电压",
                  "data_len": 3,
                  "type": "DATA_TYPE_BCD",
                  "access": "ACCESS_READ_ONLY",
                  "scale": 0.01,
                  "offset": 0.0,
                  "deadband": 0.0
                },
                {
                  "tag": "B相电压",
                  "data_len": 3,
                  "type": "DATA_TYPE_BCD",
                  "access": "ACCESS_READ_ONLY",
                  "scale": 0.01,
                  "offset": 0.0,
                  "deadband": 0.0
                },
                {
                  "tag": "C相电压",
                  "data_len": 3,
                  "type": "DATA_TYPE_BCD",
                  "access": "ACCESS_READ_ONLY",
                  "scale": 0.01,
                  "offset": 0.0,
                  "deadband": 0.0
                }
              ]
            }
          ]
        },
        // start 仅用于兼容旧模板与日志说明；当前版本不额外调用 StartLink。
        "start": true
      },
      {
        "link": {
          "config": {
            // 未使用占位符时会自动追加后缀，例如 模拟DLT645_UART主站_01
            "conn_name": "模拟DLT645_UART主站_{device_no}",
            "protocol_variant": "DLT645PCD",
            "meter_addr": "202601200002",
            "transport_type": "TRANSPORT_MQTT_UART",
            "comm_mode": "COMM_MODE_SERIAL",
            "serial_port": "RS485-1",
            "serial_baud_rate": 9600,
            "serial_data_bits": 8,
            "serial_parity": "SERIAL_PARITY_NONE",
            "serial_stop_bits": "SERIAL_STOP_BITS_ONE",
            "serial_byte_timeout_ms": 100,
            "serial_frame_timeout_ms": 100,
            "serial_est_size": 256,
            "poll_interval_ms": 1000,
            "request_timeout_ms": 300000
          }
        },
        "device_nos": [
          "01",
          "02"
        ],
        "point_table": {
          "replace": true,
          "points": [
            {
              "tag": "有功功率设定值",
              "di": "06010801",
              "data_len": 4,
              "type": "DATA_TYPE_BCD",
              // 读优先走数据块；写仍可使用单点
              "access": "ACCESS_WRITE_ONLY",
              "scale": 0.001,
              "offset": 0.0,
              "deadband": 0.0
            }
          ],
          "blocks": [
            {
              // 电压数据块：DI=0201FF00，总长度 9（A/B/C 三相各 3 字节 BCD）
              "block_di": "0201FF00",
              "block_data_len": 9,
              "items": [
                {
                  "tag": "A相电压",
                  "data_len": 3,
                  "type": "DATA_TYPE_BCD",
                  "access": "ACCESS_READ_ONLY",
                  "scale": 0.01,
                  "offset": 0.0,
                  "deadband": 0.0
                },
                {
                  "tag": "B相电压",
                  "data_len": 3,
                  "type": "DATA_TYPE_BCD",
                  "access": "ACCESS_READ_ONLY",
                  "scale": 0.01,
                  "offset": 0.0,
                  "deadband": 0.0
                },
                {
                  "tag": "C相电压",
                  "data_len": 3,
                  "type": "DATA_TYPE_BCD",
                  "access": "ACCESS_READ_ONLY",
                  "scale": 0.01,
                  "offset": 0.0,
                  "deadband": 0.0
                }
              ]
            }
          ]
        },
        // start 仅用于兼容旧模板与日志说明；当前版本不额外调用 StartLink。
        "start": false
      }
    ]
  }
}
