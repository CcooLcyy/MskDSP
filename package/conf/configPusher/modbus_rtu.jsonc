{
  // 锦浪 Solis 逆变器 ModbusRTU 配置示例（通过 MQTT UART 透传到 RS485-6）
  // 说明：
  // 1. 本文件仅供 configPusher 下发/示例使用。
  // 2. 用户提供的 iec104.signalIndex/telemetryIndex/aggregation/outputScale 不属于 ModbusRTU 配置；
  //    如需接入 IEC104，请在 iec104.jsonc 与 DataCenter.jsonc 中单独配置。
  // 3. 当前 ModbusRTU 主站 0x03/0x04 已支持 INT16/INT32；
  //    因此本文件已写入输入寄存器中的有符号点：无功功率、功率因数。
  // 4. holdingRegisters 中 3000/3001/3002 地址存在重叠；
  //    按“保留前一个占用区间、删除后续冲突起始点”的规则，已删除 3001 起始的“无功功率限值”读回/命令点。
  // 5. 当前 ModbusRTU 链路固定按主站方式运行。
  // 6. 以下 holdingRegisters 点拆成“读回/命令”两套 tag：
  //    - “xx-读回” 走 0x03 轮询；
  //    - “xx-命令” 走 0x06/0x10，通过 DataCenter 路由触发写寄存器。
  "modbus_rtu": {
    // 存在 TRANSPORT_MQTT_UART 链路时需要 mqtt 顶层配置。
    "mqtt": {
      "host": "127.0.0.1",
      "port": 1883,
      "client_id": "modbus_rtu_solis_rs485_6",
      "username": "",
      "password": "",
      "keepalive_sec": 30,
      "clean_session": true,
      "connect_timeout_ms": 3000
    },
    "links": [
      {
        "link": {
          "config": {
            "conn_name": "锦浪Solis-RS485-6",
            "transport_type": "TRANSPORT_MQTT_UART",
            // MQTT UART 场景下，serial.device 忽略；这里只保留远端串口参数。
            "serial": {
              "baud_rate": 9600,
              "data_bits": 8,
              "parity": "PARITY_NONE",
              "stop_bits": "STOP_BITS_ONE"
            },
            "serial_port": "RS485-6",
            "request_timeout_ms": 1000,
            "serial_byte_timeout_ms": 100,
            "serial_frame_timeout_ms": 100,
            "serial_est_size": 256,
            "device_id": 1,
            "poll_interval_ms": 3000,
            "address_base": "ADDRESS_BASE_ZERO",
            "read_plan": {
              "mode": "READ_PLAN_MODE_EXPLICIT",
              "blocks": [
                {
                  "function": "0x04",
                  "start": 3000,
                  "quantity": 2
                },
                {
                  "function": "0x04",
                  "start": 3009,
                  "quantity": 20
                },
                {
                  "function": "0x03",
                  "start": 3000,
                  "quantity": 5
                },
                {
                  "function": "0x03",
                  "start": 3062,
                  "quantity": 1
                }
              ]
            }
          }
        },
        "point_table": {
          "replace": true,
          "points": [
            {
              "tag": "锦浪Solis-运行状态",
              "function": "0x04",
              "address": 3000,
              "type": "DATA_TYPE_UINT16",
              "reg_count": 1,
              "byte_order": "AB",
              "scale": 1.0,
              "offset": 0.0,
              "deadband": 0.0
            },
            {
              "tag": "锦浪Solis-故障状态",
              "function": "0x04",
              "address": 3001,
              "type": "DATA_TYPE_UINT16",
              "reg_count": 1,
              "byte_order": "AB",
              "scale": 1.0,
              "offset": 0.0,
              "deadband": 0.0
            },
            {
              "tag": "锦浪Solis-A相电压",
              "function": "0x04",
              "address": 3009,
              "type": "DATA_TYPE_UINT16",
              "reg_count": 1,
              "byte_order": "AB",
              "scale": 0.1,
              "offset": 0.0,
              "deadband": 0.0
            },
            {
              "tag": "锦浪Solis-B相电压",
              "function": "0x04",
              "address": 3010,
              "type": "DATA_TYPE_UINT16",
              "reg_count": 1,
