              "scale": 0.1,
              "offset": 0.0,
              "deadband": 0.0
            },
            {
              "tag": "锦浪Solis-C相电压",
              "function": "0x04",
              "address": 3011,
              "type": "DATA_TYPE_UINT16",
              "reg_count": 1,
              "byte_order": "AB",
              "scale": 0.1,
              "offset": 0.0,
              "deadband": 0.0
            },
            {
              "tag": "锦浪Solis-A相电流",
              "function": "0x04",
              "address": 3012,
              "type": "DATA_TYPE_UINT32",
              "reg_count": 2,
              "word_order": "HL",
              "byte_order": "AB",
              "scale": 0.001,
              "offset": 0.0,
              "deadband": 0.0
            },
            {
              "tag": "锦浪Solis-B相电流",
              "function": "0x04",
              "address": 3014,
              "type": "DATA_TYPE_UINT32",
              "reg_count": 2,
              "word_order": "HL",
              "byte_order": "AB",
              "scale": 0.001,
              "offset": 0.0,
              "deadband": 0.0
            },
            {
              "tag": "锦浪Solis-C相电流",
              "function": "0x04",
              "address": 3016,
              "type": "DATA_TYPE_UINT32",
              "reg_count": 2,
              "word_order": "HL",
              "byte_order": "AB",
              "scale": 0.001,
              "offset": 0.0,
              "deadband": 0.0
            },
            {
              "tag": "锦浪Solis-频率",
              "function": "0x04",
              "address": 3019,
              "type": "DATA_TYPE_UINT16",
              "reg_count": 1,
              "byte_order": "AB",
              "scale": 0.01,
              "offset": 0.0,
              "deadband": 0.0
            },
            {
              "tag": "锦浪Solis-有功功率",
              "function": "0x04",
              "address": 3020,
              "type": "DATA_TYPE_UINT32",
              "reg_count": 2,
              "word_order": "HL",
              "byte_order": "AB",
              "scale": 0.001,
              "offset": 0.0,
              "deadband": 0.0
            },
            {
              "tag": "锦浪Solis-无功功率",
              "function": "0x04",
              "address": 3022,
              "type": "DATA_TYPE_INT32",
              "reg_count": 2,
              "word_order": "HL",
              "byte_order": "AB",
              "scale": 0.001,
              "offset": 0.0,
              "deadband": 0.0
            },
            {
              "tag": "锦浪Solis-功率因数",
              "function": "0x04",
              "address": 3024,
              "type": "DATA_TYPE_INT16",
              "reg_count": 1,
              "byte_order": "AB",
              "scale": 0.001,
              "offset": 0.0,
              "deadband": 0.0
            },
            {
              "tag": "锦浪Solis-日发电量",
              "function": "0x04",
              "address": 3025,
              "type": "DATA_TYPE_UINT32",
              "reg_count": 2,
              "word_order": "HL",
              "byte_order": "AB",
              "scale": 0.01,
              "offset": 0.0,
              "deadband": 0.0
            },
            {
              "tag": "锦浪Solis-总发电量",
              "function": "0x04",
              "address": 3027,
              "type": "DATA_TYPE_UINT32",
              "reg_count": 2,
              "word_order": "HL",
              "byte_order": "AB",
              "scale": 1.0,
              "offset": 0.0,
              "deadband": 0.0
            },
            // 以下保持寄存器点拆成“读回/命令”两套 tag。
            // 说明：已按“保留前一个占用区间、删除后续冲突起始点”的规则删除冲突点。
            {
              "tag": "锦浪Solis-有功功率限值-读回",
              "function": "0x03",
              "address": 3000,
              "type": "DATA_TYPE_UINT32",
              "reg_count": 2,
              "word_order": "HL",
              "byte_order": "AB",
              "scale": 0.001,
              "offset": 0.0,
              "deadband": 0.0
            },
            {
              "tag": "锦浪Solis-有功功率百分比-读回",
              "function": "0x03",
              "address": 3002,
              "type": "DATA_TYPE_UINT16",
              "reg_count": 1,
              "byte_order": "AB",
              "scale": 0.1,
              "offset": 0.0,
              "deadband": 0.0
            },
            {
              "tag": "锦浪Solis-无功功率百分比-读回",
              "function": "0x03",
              "address": 3003,
              "type": "DATA_TYPE_INT16",
              "reg_count": 1,
              "byte_order": "AB",
              "scale": 0.1,
              "offset": 0.0,
              "deadband": 0.0
            },
            {
              "tag": "锦浪Solis-功率控制使能-读回",
              "function": "0x03",
              "address": 3004,
              "type": "DATA_TYPE_UINT16",
              "reg_count": 1,
              "byte_order": "AB",
              "scale": 1.0,
              "offset": 0.0,
              "deadband": 0.0
            },
            {
              "tag": "锦浪Solis-开关机控制-读回",
              "function": "0x03",
              "address": 3062,
              "type": "DATA_TYPE_UINT16",
              "reg_count": 1,
              "byte_order": "AB",
              "scale": 1.0,
              "offset": 0.0,
              "deadband": 0.0
            },
            {
              "tag": "锦浪Solis-有功功率限值-命令",
              "function": "0x10",
              "address": 3000,
              "type": "DATA_TYPE_UINT32",
              "reg_count": 2,
              "word_order": "HL",
              "byte_order": "AB",
              "scale": 0.001,
              "offset": 0.0,
              "deadband": 0.0
            },
            {
              "tag": "锦浪Solis-有功功率百分比-命令",
              "function": "0x06",
              "address": 3002,
              "type": "DATA_TYPE_UINT16",
              "reg_count": 1,
              "byte_order": "AB",
              "scale": 0.1,
              "offset": 0.0,
              "deadband": 0.0
            },
            {
              "tag": "锦浪Solis-无功功率百分比-命令",
              "function": "0x06",
              "address": 3003,
              "type": "DATA_TYPE_INT16",
              "reg_count": 1,
              "byte_order": "AB",
              "scale": 0.1,
              "offset": 0.0,
              "deadband": 0.0
            },
            {
              "tag": "锦浪Solis-功率控制使能-命令",
              "function": "0x06",
              "address": 3004,
              "type": "DATA_TYPE_UINT16",
              "reg_count": 1,
