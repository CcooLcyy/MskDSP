{
  // IEC104 配置下发示例
  "iec104": {
    "links": [
      {
        "link": {
          "config": {
            "conn_name": "模拟主站",
            "role": "ROLE_SERVER",
            "local": {
              "ip": "0.0.0.0",
              "port": 2404
            },
            "remote": {
              "ip": "",
              "port": 0
            },
            "ca": 1,
            "oa": 1,
            // APCI 参数可由上位机/configPusher 配置（单位秒）；CLIENT 在 STARTDT 成功后自动总召（QOI=20）
            "apci": {
              "k": 12,
              "w": 8,
              "t0": 30,
              "t1": 15,
              "t2": 10,
              "t3": 20
            },
            // 自发遥测合包参数（仅影响从站上送）
            "telemetry_batch_window_ms": 20,
            // ASDU 单帧最大字节数（<=249），use_standard_limit=true 时忽略
            "telemetry_max_asdu_bytes": 240,
            // true: 强制使用 IEC104 标准上限（249 字节）
            "telemetry_use_standard_limit": false,
            // 自发遥测合包去重（按 IOA 保留最新）
            "telemetry_dedupe": true
          }
        },
        "point_table": {
          "replace": true,
          "points": [
            {
              "tag": "1-A相电压",
              "ioa": 16385,
              "type": "TELEMETRY_TYPE_FLOAT",
              "scale": 1.0, // 标度：工程量 = 原始值 * scale + offset（scale=0 视为 1）
              "offset": 0.0, // 偏移
              "deadband": 0.0 // 死区：工程量单位，<=0 不过滤
            }
          ]
        },
        "start": true
      }
      // client 示例（仅供参考，取消注释后可用）:
      // {
      //   "link": {
      //     "config": {
      //       "conn_name": "line-2",
      //       "role": "ROLE_CLIENT",
      //       "local": { "ip": "", "port": 0 },
      //       "remote": { "ip": "127.0.0.1", "port": 2404 },
      //       "ca": 1,
      //       "oa": 1,
      //       "apci": { "k": 12, "w": 8, "t0": 30, "t1": 15, "t2": 10, "t3": 20 }
      //     }
      //   },
      //   "point_table": { "replace": true, "points": [{ "tag": "Ua", "ioa": 100, "type": "TELEMETRY_TYPE_FLOAT" }] },
      //   "start": true
      // }
    ]
  }
}
