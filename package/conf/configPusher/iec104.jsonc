  // IEC104 配置示例：
  // 1. 104 侧作为从站，由上位机/主站访问。
  // 2. 4 个 ModbusRTU 逆变器的全部 0x04 采集点均映射到 104。
  // 3. 6201h 作为 AGC 总有功给定遥调点。
  "iec104": {
    "links": [
      {
        "link": {
          "config": {
            "conn_name": "模拟IEC104从站",
            "role": "ROLE_SERVER",
            "station_role": "STATION_ROLE_SLAVE",
            "local": {
              "ip": "0.0.0.0",
              "port": 2405
            },
            "remote": {
              "ip": "",
              "port": 0
