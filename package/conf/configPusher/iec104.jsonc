{
  // IEC104 配置下发示例
  "iec104": {
    "links": [
      {
        "link": {
          "config": {
            "conn_name": "模拟从站",
            "role": "ROLE_SERVER",
            // 站点角色：主站/从站（决定业务语义）
            "station_role": "STATION_ROLE_SLAVE",
            "local": {
              "ip": "0.0.0.0",
              "port": 2405
            },
            "remote": {
              "ip": "",
              "port": 0
            },
            "ca": 1,
            "oa": 1,
            // APCI 参数可由上位机/configPusher 配置（单位秒）；CLIENT 在 STARTDT 成功后自动总召（QOI=20）
            "apci": {
              "k": 12,
              "w": 8,
              "t0": 30,
              "t1": 15,
              "t2": 10,
              "t3": 20
            },
            // 点值上送参数（影响自发上送与总召应答）
            "point_batch_window_ms": 20,
            // ASDU 单帧最大字节数（<=249），use_standard_limit=true 时忽略
            "point_max_asdu_bytes": 240,
            // true: 强制使用 IEC104 标准上限（249 字节）
            "point_use_standard_limit": false,
            // 自发点值合包去重（按 IOA 保留最新）
            "point_dedupe": true,
            // 点值上送是否带时标（默认 false）
            "point_with_time": false,
            // 对时触发 tag（STATION_ROLE_MASTER 订阅该 tag 的 DataCenter 更新并发送对时命令）
            // 为空时默认 "__time_sync__"
            "time_sync_tag": "__time_sync__"
          }
        },
        "point_table": {
          "replace": true,
          "points": [
            {
              "tag": "1-A相电压",
              "ioa": 16385,
              "type": "POINT_TYPE_FLOAT",
              "scale": 1.0, // 标度：工程量 = 原始值 * scale + offset（scale=0 视为 1）
              "offset": 0.0, // 偏移
              "deadband": 0.0 // 死区：工程量单位，<=0 不过滤
            },
            {
              "tag": "1-总有功功率",
              "ioa": 16386,
              "type": "POINT_TYPE_FLOAT",
              "scale": 1.0, // 标度：工程量 = 原始值 * scale + offset（scale=0 视为 1）
              "offset": 0.0, // 偏移
              "deadband": 0.0 // 死区：工程量单位，<=0 不过滤
            }
          ]
        },
        "start": true
      }
      // client 示例（仅供参考，取消注释后可用）:
      // {
      //   "link": {
      //     "config": {
      //       "conn_name": "line-2",
      //       "role": "ROLE_CLIENT",
      //       "station_role": "STATION_ROLE_MASTER",
      //       "local": { "ip": "", "port": 0 },
      //       "remote": { "ip": "127.0.0.1", "port": 2404 },
      //       "ca": 1,
      //       "oa": 1,
      //       "apci": { "k": 12, "w": 8, "t0": 30, "t1": 15, "t2": 10, "t3": 20 }
      //     }
      //   },
      //   "point_table": { "replace": true, "points": [{ "tag": "Ua", "ioa": 100, "type": "POINT_TYPE_FLOAT" }] },
      //   "start": true
      // }
    ]
  }
}
