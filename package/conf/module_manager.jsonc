{
  // 启动配置模式：
  // - CONFIG_PUSHER：启动时允许 ConfigPusher 读取 JSONC 并下发配置。
  // - UPPER：启动时不允许 ConfigPusher 自动下发配置；由上位机负责下发。
  // 该字段仅在 MskDSP 进程启动时读取一次；运行中修改不会立即生效，需重启后生效。
  "boot_config_mode": "UPPER",
  // ModuleManager 启动时自动加载全部业务模块服务。
  // 模块内的协议链路、控制组和计算组仍按各自持久化配置恢复运行。
  // 日志策略为内置配置（如需调整请修改 src/core/ModuleManager/Logger.cc）：
  // - 汇总日志：./log/RTU.log；模块日志：./log/<模块名>/<模块名>.log（追加写入）
  // - 每日 00:00 或单文件达到 10 MiB 时轮转，历史日志自动压缩为 .gz
  // - 默认保留最近 60 天，根目录和每个模块目录的归档总量分别限制为 500 MiB
  "auto_start_modules": [
    "DataCenter",
    "MQTTManager",
    "IEC104",
    "ModbusRTU",
    "DLT645",
    "AGC",
    "AVC",
    "Calc"
  ]
}
