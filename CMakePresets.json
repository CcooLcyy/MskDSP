{
    "version": 6,
    "configurePresets": [
        {
            "name": "arm64",
            "displayName": "arm64-relwithdebinfo (Ninja + vcpkg)",
            "description": "Cross-compile for Linux aarch64 using vcpkg chainload toolchain.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-arm64",
            "environment": {
                "VCPKG_MAX_CONCURRENCY": "6"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_SYSTEM_NAME": "Linux",
                "CMAKE_SYSTEM_PROCESSOR": "aarch64",
                "CMAKE_C_COMPILER": "/usr/bin/aarch64-linux-gnu-gcc",
                "CMAKE_CXX_COMPILER": "/usr/bin/aarch64-linux-gnu-g++",
                "CMAKE_C_COMPILER_LAUNCHER": "ccache",
                "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
                "CMAKE_STRIP": "/usr/bin/aarch64-linux-gnu-strip",
                "CMAKE_OBJCOPY": "/usr/bin/aarch64-linux-gnu-objcopy",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "MSKDSP_STRIP_DEBUG": "ON",
                "VCPKG_HOST_TRIPLET": "x64-linux",
                "Protobuf_PROTOC_EXECUTABLE": "${sourceDir}/build-arm64/vcpkg_installed/x64-linux/tools/protobuf/protoc",
                "gRPC_CPP_PLUGIN_EXECUTABLE": "${sourceDir}/build-arm64/vcpkg_installed/x64-linux/tools/grpc/grpc_cpp_plugin",
                "VCPKG_TARGET_TRIPLET": "arm64-linux"
            }
        },
        {
            "name": "x64",
            "displayName": "GCC 14.2.0 x86_64-linux-gnu",
            "description": "正在使用编译器: C = /usr/bin/gcc-14, CXX = /usr/bin/g++-14",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "/usr/bin/gcc-14",
                "CMAKE_CXX_COMPILER": "/usr/bin/g++-14",
                "CMAKE_C_COMPILER_LAUNCHER": "ccache",
                "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "x64-linux"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "arm64",
            "description": "",
            "displayName": "",
            "configurePreset": "arm64"
        },
        {
            "name": "x64",
            "description": "",
            "displayName": "",
            "configurePreset": "x64"
        }
    ]
}
