# 通过仓库 Settings -> Actions -> Runners 中的 New self-hosted runner 获取一次性注册 token。
GITHUB_URL=https://github.com/<owner>/<repository>
RUNNER_TOKEN=
RUNNER_NAME=mskdsp-lower-builder-01
RUNNER_LABELS=lower-builder,x64
RUNNER_GROUP=Default

# 可选。停止容器时使用专用移除 token 主动从 GitHub 注销 runner；长期运行通常留空。
RUNNER_REMOVE_TOKEN=

# 可选。默认版本会在 runner 启动时自动更新。
RUNNER_VERSION=2.321.0

# 构建机访问 GitHub release asset 超时时可填可访问的代理地址。
RUNNER_DOWNLOAD_BASE_URL=https://github.com
