# 通过仓库 Settings -> Actions -> Runners 中的 New self-hosted runner 获取一次性注册 token。
GITHUB_URL=https://github.com/<owner>/<repository>
RUNNER_TOKEN=
RUNNER_NAME=mskdsp-lower-builder-01
RUNNER_LABELS=lower-builder,x64
RUNNER_GROUP=Default

# 可选。停止容器时使用专用移除 token 主动从 GitHub 注销 runner；长期运行通常留空。
RUNNER_REMOVE_TOKEN=

# 固定 runner 镜像版本；当前版本为 GitHub Actions Runner 2.337.0。
RUNNER_VERSION=2.337.0

# 远端无法稳定下载更新包时保持 true，避免运行中的 job 因自动更新失败被取消。
RUNNER_DISABLE_UPDATE=true

# 构建机访问 GitHub release asset 超时时可填可访问的代理地址。
RUNNER_DOWNLOAD_BASE_URL=https://github.com

# Clash Verge/Mihomo HTTP 代理。host 网络模式下 127.0.0.1 指宿主机。
# 不使用代理时将这两个值设为空，并在 compose 中保留 host 网络。
RUNNER_HTTP_PROXY=http://127.0.0.1:7897
RUNNER_HTTPS_PROXY=http://127.0.0.1:7897
RUNNER_NO_PROXY=localhost,127.0.0.1,::1
